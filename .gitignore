# Secrets / credentials — never commit these
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*

# Logs / data / backtest output
*.log
logs/
data/
backtest_results/
user_data/hyperopt_results/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 合成資料與其回測產出(僅供管線整合測試,見 docs/pipeline-findings.md)。
# 產生器 analysis/tools/make_synthetic_data.py 有進 git,產物本身不進 —— 可隨時重新產生,
# 且絕不可與真實回測結果混淆。
user_data/data_synthetic/
user_data/backtest_synthetic/

# hyperopt 選出的參數覆寫檔:是每個 fold 各自的產物、且會被下一個 fold 覆寫
# (見 docs/pipeline-findings.md 發現二),不應以「當下剛好是誰的參數」進版控
user_data/strategies/*.json

# Freqtrade per-environment secrets (security-policy.md 2.2 節,實測驗證過的 glob pattern)
user_data/configs/secrets-*.json
!user_data/configs/secrets-*.example.json

# Docker per-environment env files carrying FREQTRADE__EXCHANGE__KEY/SECRET (security-policy.md 2.1 節)
deploy/*.env
!deploy/*.example.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
