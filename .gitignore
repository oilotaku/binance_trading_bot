# Secrets / credentials — never commit these
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*

# Logs / data / backtest output
*.log
logs/
data/
backtest_results/
user_data/hyperopt_results/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Freqtrade per-environment secrets (security-policy.md 2.2 節,實測驗證過的 glob pattern)
user_data/configs/secrets-*.json
!user_data/configs/secrets-*.example.json

# Docker per-environment env files carrying FREQTRADE__EXCHANGE__KEY/SECRET (security-policy.md 2.1 節)
deploy/*.env
!deploy/*.example.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
